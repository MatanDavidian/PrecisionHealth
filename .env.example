# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are safe in a client bundle: the anon key grants only what
# Row-Level Security allows. Never use the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — enables the Supabase contract tests (see supabase/README.md).
# Create the user in Authentication → Users with "Auto Confirm User" ticked.
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
