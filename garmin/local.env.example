# Copy to local.env and fill in. local.env is gitignored and never committed.
#
# Sideloaded apps get no settings page in Garmin Connect — that list comes from
# your Connect IQ account, not from what is on the watch — so these are
# compiled in instead. build.sh generates source/BuildConfig.mc from this file,
# and that file is gitignored too.
SYNC_URL=https://YOUR-PROJECT.supabase.co/functions/v1/device-sync
DEVICE_TOKEN=
