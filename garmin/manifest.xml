<?xml version="1.0"?>
<!--
  Deliberately minimal.

  There is no Communications permission, and that is the point rather than an
  oversight: version 0 sends nothing anywhere, so it cannot depend on the phone,
  cannot prompt about network access, and cannot be accused of having tested
  something other than what it claims. Add it in the same commit that adds sync.

  UserProfile is the one permission here. VO2 max and resting heart rate live on
  UserProfile.Profile and are unreachable without it; every use is guarded, so a
  refusal degrades to "--" rather than crashing.

  THE ID BELOW WAS INVENTED, AND SHOULD BE REGENERATED BEFORE THIS IS ANYTHING
  BUT DISPOSABLE.

  Run `Monkey C: Regenerate UUID` from the VS Code command palette, once, and
  then never change it again. This is the application's own identity and is NOT
  the Connect IQ Store identifier — the Store issues a separate public id later,
  and Garmin's intent API distinguishes the two as manifest-id:// and
  store-id://. Changing the manifest UUID after release makes an installed app
  and its update look like two different applications.

  A syntactically valid value is left in place so the project builds and runs on
  a watch today; that is all it is for.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
  <iq:application
      entry="PocApp"
      id="a7c41e0b93d64f8fa1b25c60d7e3849f"
      launcherIcon="@Drawables.LauncherIcon"
      minApiLevel="3.2.0"
      name="@Strings.AppName"
      type="watch-app">

    <!-- Start with the one watch we can actually test on. Widening this list is
         a manifest edit and a rebuild, not a code change. -->
    <iq:products>
      <iq:product id="fr265"/>
      <iq:product id="fr265s"/>
    </iq:products>

    <iq:permissions>
      <iq:uses-permission id="UserProfile"/>
    </iq:permissions>

    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>
  </iq:application>
</iq:manifest>
