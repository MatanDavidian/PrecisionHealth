<?xml version="1.0"?>
<!--
  Deliberately minimal.

  There is no Communications permission, and that is the point rather than an
  oversight: version 0 sends nothing anywhere, so it cannot depend on the phone,
  cannot prompt about network access, and cannot be accused of having tested
  something other than what it claims. Add it in the same commit that adds sync.

  UserProfile is the one permission here. VO2 max and resting heart rate live on
  UserProfile.Profile and are unreachable without it; every use is guarded, so a
  refusal degrades to a dash rather than crashing.

  THE ID BELOW IS REAL AND MUST NEVER CHANGE AGAIN.

  It was invented while this was a disposable probe, and regenerating it was
  S4.3 — done once, at the last moment it was free. This is the application's
  own identity and is NOT the Connect IQ Store identifier; the Store issues a
  separate public id later, and Garmin's intent API distinguishes the two as
  manifest-id:// and store-id://.

  Changing it after release makes an installed app and its update look like two
  different applications: the old one is orphaned on the watch, with its
  settings — including the device token — stranded inside it. That is why this
  had to happen before anyone but the author had it installed, and why it
  cannot happen again.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
  <iq:application
      entry="PocApp"
      id="a94cbd8994124afb834699207f22977a"
      launcherIcon="@Drawables.LauncherIcon"
      minApiLevel="3.2.0"
      name="@Strings.AppName"
      type="watch-app">

    <!-- Start with the one watch we can actually test on. Widening this list is
         a manifest edit and a rebuild, not a code change. -->
    <iq:products>
      <iq:product id="fr265"/>
      <iq:product id="fr265s"/>
    </iq:products>

    <!--
      Communications is here now because the app sends. It was deliberately
      absent while this was a read-only probe, so that build could not be
      accused of doing anything but what it claimed.
    -->
    <iq:permissions>
      <iq:uses-permission id="Background"/>
      <iq:uses-permission id="Communications"/>
      <iq:uses-permission id="UserProfile"/>
    </iq:permissions>

    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>
  </iq:application>
</iq:manifest>
