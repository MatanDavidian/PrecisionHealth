# Vite fingerprints every asset (index-DEBcp-uF.js), so those filenames only
# ever describe one build and can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must not be cached: it is the file that points at the current
# asset names, so a stale copy pins the browser to a previous deploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# The service worker is checked for updates on every visit; a cached copy
# would keep people on an old build.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# Security, on every response.
#
# payment=(self): Google Play Billing in the Android app runs through the
# Payment Request API, on this origin only (docs/ANDROID-APP.md, step 4).
#
# The CSP is ENFORCED (since 2026-10-09), after six days in report-only mode
# with no violations: the browser suite walks the app under this exact policy
# on every CI run (e2e/security-headers.spec.ts), and the daily check:live
# fails on any console error, which is where violations surface.
#
# connect-src: our own origin, this Supabase project (https and the realtime
# socket), and api.openai.com for people who analyse on their own key.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://vdzphvyoqlkcrovtqdlk.supabase.co wss://vdzphvyoqlkcrovtqdlk.supabase.co https://api.openai.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), payment=(self), usb=()
  Strict-Transport-Security: max-age=31536000
