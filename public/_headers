# Vite fingerprints every asset (index-DEBcp-uF.js), so those filenames only
# ever describe one build and can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must not be cached: it is the file that points at the current
# asset names, so a stale copy pins the browser to a previous deploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Security, on every response.
#
# The CSP starts as REPORT-ONLY: a wrong policy blanks the site for everyone,
# so it is observed first (violations surface as console errors, which the
# browser suite and check:live both fail on) and enforced once a week of real
# use shows nothing. X-Frame-Options is enforced now — clickjacking protection
# that report-only mode cannot give (frame-ancestors is ignored there).
#
# connect-src: our own origin, this Supabase project (https and the realtime
# socket), and api.openai.com for people who analyse on their own key.
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://vdzphvyoqlkcrovtqdlk.supabase.co wss://vdzphvyoqlkcrovtqdlk.supabase.co https://api.openai.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
